    {
      "name": "generic-form",
      "type": "registry:ui",
      "title": "Generic Form",
      "description": "A schema-driven generic form built on react-hook-form and Zod. Wraps useForm with a zod resolver, shares the instance through FormProvider, and exposes a imperative ref API. Ships with a TextField input, a TextAreaField multiline field, a PhoneField phone number field, a SelectField static select, AsyncSelectField and AsyncMultiSelectField async selects, and a DatePicker for calendar dates.",
      "dependencies": [
        "react-hook-form",
        "zod",
        "@hookform/resolvers",
        "date-fns",
        "react-phone-number-input"
      ],
      "registryDependencies": [
