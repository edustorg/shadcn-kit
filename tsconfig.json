{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/components/data-table/*": ["./registry/items/data-table/*"],
      "@/components/ui/faceted": ["./registry/items/data-table/ui/faceted"],
      "@/lib/data-table": ["./registry/items/data-table/lib/data-table"],
      "@/lib/parsers": ["./registry/items/data-table/lib/parsers"],
      "@/lib/format": ["./registry/items/data-table/lib/format"],
      "@/lib/id": ["./registry/items/data-table/lib/id"],
      "@/lib/compose-refs": ["./registry/items/data-table/lib/compose-refs"],
      "@/hooks/use-data-table": ["./registry/items/data-table/hooks/use-data-table"],
      "@/hooks/use-callback-ref": ["./registry/items/data-table/hooks/use-callback-ref"],
      "@/hooks/use-debounced-callback": ["./registry/items/data-table/hooks/use-debounced-callback"],
      "@/config/data-table": ["./registry/items/data-table/config/data-table"],
      "@/types/data-table": ["./registry/items/data-table/types/data-table"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
