        "date-fns",
        "react-hook-form"
      ],
      "registryDependencies": [
        "utils",
        "button",
        "calendar",
        "popover",
        "field"
      ],
      "files": [
        {
          "path": "registry/items/date-picker/date-picker.tsx",
          "type": "registry:ui",
          "target": "@ui/edust-kit/date-picker.tsx"
        }
      ]
    }
  ]
}
